{
  "manifest_version": 3,
  "name": "Safe Signal",
  "version": "1.1",
  "description": "On-device cyberbullying detection.",
  "minimum_chrome_version": "116",

  "permissions": [
    "offscreen",
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Safe Signal"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "model/*",
        "libs/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
